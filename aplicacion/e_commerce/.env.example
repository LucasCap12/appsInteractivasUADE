# ==============================================================================
# VARIABLES DE ENTORNO - E-COMMERCE API
# ==============================================================================
# IMPORTANTE: 
# 1. Copiar este archivo a .env:  cp .env.example .env
# 2. Modificar valores según tu entorno
# 3. NO subir .env a Git (ya está en .gitignore)
# 4. En producción, usar secretos de Docker/Kubernetes
# ==============================================================================

# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================================
# Nombre de la base de datos
DB_NAME=ecommerce_tpo

# Usuario de MySQL (no usar root en producción)
DB_USER=ecommerce_user

# Contraseña del usuario (cambiar en producción)
DB_PASSWORD=ecommerce_pass

# Contraseña de root de MySQL
DB_ROOT_PASSWORD=root

# ============================================================================
# CONFIGURACIÓN JWT (JSON Web Tokens)
# ============================================================================
# Secret key para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN)
# Generar con: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Tiempo de expiración del token en milisegundos
# 86400000 ms = 24 horas
JWT_EXPIRATION=86400000

# ============================================================================
# CONFIGURACIÓN SPRING BOOT
# ============================================================================
# Perfil activo (dev, prod)
SPRING_PROFILE=prod

# Mostrar SQL en logs (útil para debug, desactivar en producción)
SHOW_SQL=false

# ==============================================================================
# NOTAS DE SEGURIDAD
# ==============================================================================
# ⚠️  Cambiar todos los valores por defecto en producción
# ⚠️  JWT_SECRET debe ser único y mantenerlo secreto
# ⚠️  Usar contraseñas fuertes para MySQL
# ⚠️  No commitear el archivo .env a Git
# ==============================================================================
