# =============================================================================
aplicacion/e_commerce/target/
aplicacion/e_commerce/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!aplicacion/e_commerce/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

